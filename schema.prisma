  productId        String?        @map("product")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt

  @@index([purchaseOrderId])
  @@index([productId])
}

model PriceAlert {
  id           String    @id @default(cuid())
  user         User      @relation("PriceAlert_user", fields: [userId], references: [id])
  userId       String    @map("user")
  product      String    @default("")
  productRef   Product?  @relation("PriceAlert_productRef", fields: [productRefId], references: [id])
  productRefId String?   @map("productRef")
  targetPrice  Decimal   @postgresql.Decimal(12, 2)
  currentPrice Decimal?  @postgresql.Decimal(12, 2)
  isTriggered  Boolean   @default(false)
  notifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([userId])
  @@index([product])
  @@index([productRefId])
}

model Product {
  id                               String                    @id @default(cuid())
  title                            String                    @default("")
  description                      Json                      @default("[{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]}]")
  handle                           String                    @unique @default("")
  sku                              String                    @default("")
  status                           ProductStatusType         @default(draft)
  metadata                         Json?
  price                            Float?
  priceCents                       Int                       @default(0)
  compareAtPrice                   Float?
  costPrice                        Float?
  costPriceCents                   Int                       @default(0)
  inStock                          Boolean                   @default(false)
  stockQuantity                    Int?                      @default(0)
  lowStockThreshold                Int?                      @default(10)
  imageUrl                         String                    @default("")
  thumbnailUrl                     String                    @default("")
  department                       ProductDepartmentType?
  isPerishable                     Boolean                   @default(false)
  shelfLife                        Int?
  pricingMethod                    ProductPricingMethodType? @default(unit)
  unitOfMeasure                    ProductUnitOfMeasureType? @default(each)
  organicCertified                 Boolean                   @default(false)
  allergens                        Json                      @default("[]")
  store                            Store                     @relation("Product_store", fields: [storeId], references: [id])
  storeId                          String                    @map("store")
  supplier                         Supplier?                 @relation("Product_supplier", fields: [supplierId], references: [id])
  supplierId                       String?                   @map("supplier")
  departmentRef                    Department?               @relation("Product_departmentRef", fields: [departmentRefId], references: [id])
  departmentRefId                  String?                   @map("departmentRef")
  inventoryLots                    InventoryLot[]            @relation("InventoryLot_product")
  favoriteProducts                 FavoriteProduct[]         @relation("FavoriteProduct_productRef")
  backInStockAlerts                BackInStockAlert[]        @relation("BackInStockAlert_productRef")
  priceAlerts                      PriceAlert[]              @relation("PriceAlert_productRef")
  shoppingListItems                ShoppingListItem[]        @relation("ShoppingListItem_productRef")
  subscriptions                    Subscription[]            @relation("Subscription_productRef")
  recipeIngredients                RecipeIngredient[]        @relation("RecipeIngredient_productRef")
  createdAt                        DateTime                  @default(now())
  updatedAt                        DateTime                  @default(now()) @updatedAt
  from_CartItem_product            CartItem[]                @relation("CartItem_product")
  from_InventoryAdjustment_product InventoryAdjustment[]     @relation("InventoryAdjustment_product")
  from_OrderLineItem_product       OrderLineItem[]           @relation("OrderLineItem_product")
  from_POItem_product              POItem[]                  @relation("POItem_product")

  @@index([storeId])
  @@index([supplierId])
  @@index([departmentRefId])
}

model PurchaseOrder {
  id                   String                   @id @default(cuid())
  poNumber             String                   @unique @default("")
  idempotencyKey       String?                  @unique
  supplierName         String                   @default("")
  supplierEmail        String                   @default("")
  orderDate            DateTime                 @default(now())
  expectedDeliveryDate DateTime?
  status               PurchaseOrderStatusType? @default(draft)
  totalAmount          Float?
  totalAmountCents     Int                      @default(0)
  receivedAt           DateTime?
  notes                String                   @default("")
  store                Store                    @relation("PurchaseOrder_store", fields: [storeId], references: [id])
  storeId              String                   @map("store")
  supplier             Supplier?                @relation("PurchaseOrder_supplier", fields: [supplierId], references: [id])
  supplierId           String?                  @map("supplier")
  items                POItem[]                 @relation("POItem_purchaseOrder")
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @default(now()) @updatedAt

  @@index([storeId])
  @@index([supplierId])
}

model Recipe {
  id           String                @id @default(cuid())
  name         String                @default("")
  description  String                @default("")
  instructions String                @default("")
  prepTime     Int?
  cookTime     Int?
  servings     Int?
  difficulty   RecipeDifficultyType? @default(medium)
  image        String                @default("")
  categories   Json?
  ingredients  RecipeIngredient[]    @relation("RecipeIngredient_recipe")
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @default(now()) @updatedAt
}

model RecipeIngredient {
  id           String   @id @default(cuid())
  recipe       Recipe?  @relation("RecipeIngredient_recipe", fields: [recipeId], references: [id])
  recipeId     String?  @map("recipe")
  product      String   @default("")
  productRef   Product? @relation("RecipeIngredient_productRef", fields: [productRefId], references: [id])
  productRefId String?  @map("productRef")
  quantity     Float
  unit         String   @default("")
  notes        String   @default("")
  isOptional   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([recipeId])
  @@index([productRefId])
}

model RateLimitBucket {
  id              String   @id @default(cuid())
  key             String   @unique @default("")
  windowStartedAt DateTime
  requestCount    Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model Role {
  id                  String   @id @default(cuid())
  name                String   @default("")
  canManageProducts   Boolean  @default(false)
  canManageOrders     Boolean  @default(false)
  canManagePayments   Boolean  @default(false)
  canManageInventory  Boolean  @default(false)
  canManageSuppliers  Boolean  @default(false)
  canManageDelivery   Boolean  @default(false)
  canManageUsers      Boolean  @default(false)
  canManageOnboarding Boolean  @default(false)
  canAccessDashboard  Boolean  @default(false)
  store               Store    @relation("Role_store", fields: [storeId], references: [id])
  storeId             String   @map("store")
  assignedTo          User[]   @relation("User_role")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([storeId])
}

model ShoppingList {
  id        String             @id @default(cuid())
  user      User               @relation("ShoppingList_user", fields: [userId], references: [id])
  userId    String             @map("user")
  name      String             @default("")
  isDefault Boolean            @default(false)
  items     ShoppingListItem[] @relation("ShoppingListItem_list")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @default(now()) @updatedAt

  @@index([userId])
}

model ShoppingListItem {
  id           String       @id @default(cuid())
  list         ShoppingList @relation("ShoppingListItem_list", fields: [listId], references: [id])
  listId       String       @map("list")
  product      String       @default("")
  productRef   Product      @relation("ShoppingListItem_productRef", fields: [productRefId], references: [id])
  productRefId String       @map("productRef")
  quantity     Int          @default(1)
  unit         String       @default("")
  checked      Boolean      @default(false)
  notes        String       @default("")
  addedAt      DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt

  @@index([listId])
  @@index([productRefId])
}

model Subscription {
  id               String                    @id @default(cuid())
  user             User                      @relation("Subscription_user", fields: [userId], references: [id])
  userId           String                    @map("user")
  product          String                    @default("")
  productRef       Product                   @relation("Subscription_productRef", fields: [productRefId], references: [id])
  productRefId     String                    @map("productRef")
  quantity         Int                       @default(1)
  frequency        SubscriptionFrequencyType @default(weekly)
  nextDeliveryDate DateTime?
  discount         Float?                    @default(0)
  discountBps      Int                       @default(0)
  isActive         Boolean                   @default(true)
  pausedUntil      DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @default(now()) @updatedAt

  @@index([userId])
  @@index([product])
  @@index([productRefId])
}

model SubstitutionPreference {
  id                      String   @id @default(cuid())
  user                    User     @relation("SubstitutionPreference_user", fields: [userId], references: [id])
  userId                  String   @map("user")
  allowSubstitutions      Boolean  @default(true)
  preferSimilarBrand      Boolean  @default(true)
  preferSimilarSize       Boolean  @default(true)
  contactBeforeSubstitute Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now()) @updatedAt

  @@index([userId])
}

model Store {
  id                            String                         @id @default(cuid())
  code                          String                         @unique @default("")
  name                          String                         @default("")
  timezone                      String                         @default("America/Los_Angeles")
  currencyCode                  String                         @default("USD")
  isActive                      Boolean                        @default(true)
  users                         User[]                         @relation("User_store")
  roles                         Role[]                         @relation("Role_store")
  settings                      StoreSettings[]                @relation("StoreSettings_store")
  loyaltyPrograms               LoyaltyProgram[]               @relation("LoyaltyProgram_store")
  carts                         Cart[]                         @relation("Cart_store")
  orders                        Order[]                        @relation("Order_store")
  products                      Product[]                      @relation("Product_store")
  departments                   Department[]                   @relation("Department_store")
  coupons                       Coupon[]                       @relation("Coupon_store")
  suppliers                     Supplier[]                     @relation("Supplier_store")
  inventoryLots                 InventoryLot[]                 @relation("InventoryLot_store")
  inventoryAdjustments          InventoryAdjustment[]          @relation("InventoryAdjustment_store")
  checkoutAttempts              CheckoutAttempt[]              @relation("CheckoutAttempt_store")
  deliverySlots                 DeliverySlot[]                 @relation("DeliverySlot_store")
  pickupSlots                   PickupSlot[]                   @relation("PickupSlot_store")
  parkingSpots                  ParkingSpot[]                  @relation("ParkingSpot_store")
  deliveryRoutes                DeliveryRoute[]                @relation("DeliveryRoute_store")
  purchaseOrders                PurchaseOrder[]                @relation("PurchaseOrder_store")
  payments                      Payment[]                      @relation("Payment_store")
  orderLineInventoryAllocations OrderLineInventoryAllocation[] @relation("OrderLineInventoryAllocation_store")
  paymentWebhookEvents          PaymentWebhookEvent[]          @relation("PaymentWebhookEvent_store")
  outboxEvents                  GroceryOutboxEvent[]           @relation("GroceryOutboxEvent_store")
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @default(now()) @updatedAt
}

model StoreSettings {
  id                  Int      @id @default(autoincrement())
  store               Store    @relation("StoreSettings_store", fields: [storeId], references: [id])
  storeId             String   @unique @map("store")
  name                String   @default("Juniper Market")
  tagline             String   @default("Neighborhood grocery · delivery & curbside pickup")
  homepageTitle       String   @default("Fresh from the neighborhood")
  homepageDescription String   @default("Seasonal produce, pantry staples, and household essentials selected for everyday shopping.")
  contactEmail        String   @default("hello@junipermarket.example")
  contactPhone        String   @default("(415) 555-0148")
  address             String   @default("184 Juniper Street, San Francisco, CA 94107")
  logoUrl             String   @default("/logo.svg")
  brandHue            Int?
  currencyCode        String   @default("USD")
  taxRateBps          Int      @default(875)
  locale              String   @default("en-US")
  timezone            String   @default("America/Los_Angeles")
  countryCode         String   @default("US")
  hours               Json?    @default("{\"monday\":\"8:00 AM - 8:00 PM\",\"tuesday\":\"8:00 AM - 8:00 PM\",\"wednesday\":\"8:00 AM - 8:00 PM\",\"thursday\":\"8:00 AM - 8:00 PM\",\"friday\":\"8:00 AM - 9:00 PM\",\"saturday\":\"8:00 AM - 9:00 PM\",\"sunday\":\"9:00 AM - 7:00 PM\"}")
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([storeId])
}

model Supplier {
  id                String                   @id @default(cuid())
  name              String                   @default("")
  contactName       String                   @default("")
  email             String                   @default("")
  phone             String                   @default("")
  paymentTerms      SupplierPaymentTermType? @default(net_30)
  deliveryDays      Json                     @default("[]")
  minimumOrder      Float?
  minimumOrderCents Int                      @default(0)
  store             Store                    @relation("Supplier_store", fields: [storeId], references: [id])
  storeId           String                   @map("store")
  products          Product[]                @relation("Product_supplier")
  inventoryLots     InventoryLot[]           @relation("InventoryLot_supplier")
  purchaseOrders    PurchaseOrder[]          @relation("PurchaseOrder_supplier")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @default(now()) @updatedAt

  @@index([storeId])
}

model User {
  id                                    String                    @id @default(cuid())
  name                                  String                    @default("")
  email                                 String                    @unique @default("")
  password                              String
  store                                 Store                     @relation("User_store", fields: [storeId], references: [id])
  storeId                               String                    @map("store")
  role                                  Role?                     @relation("User_role", fields: [roleId], references: [id])
  roleId                                String?                   @map("role")
  paymentRefunds                        PaymentRefund[]           @relation("PaymentRefund_requestedBy")
  onboardingStatus                      UserOnboardingStatusType? @default(not_started)
  createdAt                             DateTime                  @default(now())
  updatedAt                             DateTime                  @default(now()) @updatedAt
  passwordResetToken                    String?
  passwordResetIssuedAt                 DateTime?
  passwordResetRedeemedAt               DateTime?
  from_Address_user                     Address[]                 @relation("Address_user")
  from_BackInStockAlert_user            BackInStockAlert[]        @relation("BackInStockAlert_user")
  from_Cart_customer                    Cart[]                    @relation("Cart_customer")
  from_Department_manager               Department[]              @relation("Department_manager")
  from_DeliveryRoute_driver             DeliveryRoute[]           @relation("DeliveryRoute_driver")
  from_FavoriteProduct_user             FavoriteProduct[]         @relation("FavoriteProduct_user")
  from_InventoryAdjustment_adjustedBy   InventoryAdjustment[]     @relation("InventoryAdjustment_adjustedBy")
  from_LoyaltyTransaction_user          LoyaltyTransaction[]      @relation("LoyaltyTransaction_user")
  from_NotificationPreference_user      NotificationPreference[]  @relation("NotificationPreference_user")
  from_Order_user                       Order[]                   @relation("Order_user")
  from_OrderItemSubstitution_recordedBy OrderItemSubstitution[]   @relation("OrderItemSubstitution_recordedBy")
  from_Payment_processedBy              Payment[]                 @relation("Payment_processedBy")
  from_PriceAlert_user                  PriceAlert[]              @relation("PriceAlert_user")
  from_ShoppingList_user                ShoppingList[]            @relation("ShoppingList_user")
  from_Subscription_user                Subscription[]            @relation("Subscription_user")
  from_SubstitutionPreference_user      SubstitutionPreference[]  @relation("SubstitutionPreference_user")
  from_UserCoupon_user                  UserCoupon[]              @relation("UserCoupon_user")

  @@index([storeId])
  @@index([roleId])
}

model UserCoupon {
  id        String    @id @default(cuid())
  user      User      @relation("UserCoupon_user", fields: [userId], references: [id])
  userId    String    @map("user")
  coupon    Coupon    @relation("UserCoupon_coupon", fields: [couponId], references: [id])
  couponId  String    @map("coupon")
  clippedAt DateTime? @default(now())
  usedAt    DateTime?
  used      Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([userId])
  @@index([couponId])
}

