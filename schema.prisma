  pending
  settled_pending_finalize
  finalizing
  finalized
  compensation_required
  compensation_processing
  compensated
  failed
}

enum CartItemSubstitutionPreferenceType {
  allow
  contact
  remove
}

enum CouponDiscountTypeType {
  percentage
  fixed
  bogo
}

enum DepartmentTemperatureZoneType {
  ambient
  refrigerated
  frozen
}

enum DeliveryRouteTimeWindowType {
  time_8_10
  time_10_12
  time_12_14
  time_14_16
  time_16_18
  time_18_20
}

enum DeliveryRouteStatusType {
  planning
  in_progress
  completed
}

enum InventoryAdjustmentReasonType {
  cycle_count
  damage
  spoilage
  correction
}

enum LoyaltyTransactionTypeType {
  earned_purchase
  earned_bonus
  earned_referral
  earned_birthday
  redeemed_discount
  redeemed_reward
  expired
  adjusted
  refund_deducted
}

enum OrderStatusType {
  pending
  picking
  packed
  out_for_delivery
  delivered
  cancelled
}

enum OrderDeliveryTimeWindowType {
  time_8_10
  time_10_12
  time_12_14
  time_14_16
  time_16_18
  time_18_20
}

enum OrderSubstitutionPreferenceType {
  call_me
  best_match
  refund
}

enum PaymentRefundStatusType {
  processing
  succeeded
  failed
  canceled
}

enum PaymentWebhookEventStatusType {
  processing
  processed
  ignored
  unmatched
}

enum ProductStatusType {
  draft
  published
  archived
}

enum ProductDepartmentType {
  produce
  meat
  seafood
  dairy
  bakery
  deli
  frozen
  pantry
  beverages
  snacks
  health_beauty
  household
}

enum ProductPricingMethodType {
  unit
  weight
  volume
}

enum ProductUnitOfMeasureType {
  each
  lb
  oz
  kg
  g
  L
  mL
  gallon
  quart
  pint
}

enum PurchaseOrderStatusType {
  draft
  sent
  confirmed
  received
  cancelled
}

enum RecipeDifficultyType {
  easy
  medium
  hard
}

enum SubscriptionFrequencyType {
  weekly
  biweekly
  monthly
}

enum SupplierPaymentTermType {
  net_30
  net_60
  cod
}

enum UserOnboardingStatusType {
  not_started
  in_progress
  completed
  dismissed
}
