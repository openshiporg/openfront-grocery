# Core application
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/runtime_grocery?schema=public&connection_limit=2&pool_timeout=60
SHADOW_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/runtime_grocery_shadow?schema=public&connection_limit=2&pool_timeout=60
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_MAX_AGE_SECONDS=604800
PUBLIC_STORE_ID=store_juniper
PUBLIC_SIGNUPS_ALLOWED=false

# Canonical public URL (required in production). Portless development derives
# its origin from the forwarded request and needs no URL-specific override.
NEXT_PUBLIC_SITE_URL=https://grocery.example.com

# Stripe checkout is off unless STRIPE_ENABLED=true. When it is on, all three keys are
# required; production uses live-mode keys unless STRIPE_ALLOW_TEST_MODE=true. Missing or
# incomplete Stripe settings only make Stripe unavailable for new payments; the app still starts.
STRIPE_ENABLED=false
STRIPE_ALLOW_TEST_MODE=false
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Optional: comma-separated HTTPS origins allowed for custom remote payment adapters.
PAYMENT_ADAPTER_ALLOWED_ORIGINS=

# Client addresses (used for per-visitor abuse limits) are read from X-Real-IP only when
# TRUSTED_PROXY=true, which is safe only behind an edge that overwrites that header
# (Railway HTTP ingress). Otherwise the app uses the socket address.
TRUSTED_PROXY=false

# S3-compatible image storage (required in production)
S3_BUCKET_NAME=replace-with-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
S3_ENDPOINT=https://s3.example.com

# Mail / password reset
SMTP_FROM=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password

# Background workers act as explicit staff members of an active Store
GROCERY_EVENT_WORKER_USER_ID=replace-with-store-scoped-onboarding-operator-id
GROCERY_SUBSCRIPTION_OPERATOR_ID=replace-with-store-scoped-order-operator-id

# Refund reconciliation worker and one-shot command
REFUND_RECONCILIATION_USER_ID=replace-with-store-scoped-payment-operator-id
REFUND_RECONCILIATION_STORE_ID=store_juniper
REFUND_RECONCILIATION_WORKER_ID=grocery-refund-worker-1
REFUND_RECONCILIATION_INTERVAL_MS=10000
REFUND_RECONCILIATION_PROVIDER_TIMEOUT_MS=10000
REFUND_RECONCILE_LIMIT=20

# Optional local-only credential-bound payment adapter (never production checkout)
GROCERY_PAYMENT_TEST_SECRET=replace-with-local-test-adapter-secret

# Optional AI/MCP routes
MCP_ENABLED=false
OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MAX_TOKENS=4096
